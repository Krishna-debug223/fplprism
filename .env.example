# Optional canonical URL override. On Vercel the app automatically uses
# VERCEL_PROJECT_PRODUCTION_URL until you add a custom domain.
# Set this when you want canonical/share URLs to use a custom domain.
NEXT_PUBLIC_SITE_URL=

# Use a real inbox before broad public promotion, e.g. privacy@yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional user accounts and cloud-saved planning defaults.
# Get these from the Supabase project Connect panel. The publishable key is safe
# to expose in the browser; never put a service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google AdSense. The publisher client is public; create responsive ad units
# in AdSense and add their slot IDs in Vercel before expecting paid placements.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-1252559919094271
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=

# Optional sportsbook market prior. The app works normally without these.
# The API key stays server-side and is never exposed to the browser.
SPORTSBOOK_ENABLED=false
SPORTSBOOK_PROVIDER=the-odds-api
THE_ODDS_API_KEY=
SPORTSBOOK_REGIONS=uk

# IMPORTANT: keep this at 0 until timestamped predeadline odds improve player xPts prospectively.
# Valid production range is 0 to 0.25. A zero weight can still display feed status
# while leaving projections identical to the core model.
SPORTSBOOK_MODEL_WEIGHT=0
